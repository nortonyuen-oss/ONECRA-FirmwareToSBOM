# Build artifacts (regenerate with scripts/build-portable.ps1)
__pycache__/
*.pyc
build/
dist/
dist-portable/

# Local Claude Code settings (machine/user-specific)
.claude/settings.local.json

# Test build output (regenerate: python tests/make_fixtures.py)
tests/fixtures/
# Third-party schemas fetched for validation (python tests/fetch_schema.py)
tests/schema/

# Real vendor firmware for the corpus tests (python scripts/fetch-corpus.py)
corpus/

# docs/ is the GitHub Pages source and IS tracked - but not the zip. Since
# v1.20.0 the download is served from the GitHub release asset, so a release
# no longer adds ~11 MB to the repository. See docs/README.md.
docs/downloads/
