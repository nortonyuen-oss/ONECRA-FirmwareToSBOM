# Build artifacts (regenerate via README's PyInstaller / embeddable-Python instructions)
__pycache__/
*.pyc
build/
dist/
dist-portable/

# fw2sbom-service.spec IS tracked: it is not the file PyInstaller generates by
# default, it carries the signature packs in `datas`, and a frozen build
# without them finds nothing in every firmware it is given.

# Local Claude Code settings (machine/user-specific)
.claude/settings.local.json

# Test build output (regenerate: python tests/make_fixtures.py)
tests/fixtures/
# Third-party schemas fetched for validation (python tests/fetch_schema.py)
tests/schema/

# Real vendor firmware for the corpus tests (python scripts/fetch-corpus.py)
corpus/

# docs/ is the GitHub Pages source and IS tracked, zip included: Pages can only
# serve files that are in the repository, so the download has to live there.
